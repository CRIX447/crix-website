// ============================================================
//  FIRESTORE RULES  —  the DATABASE
// ------------------------------------------------------------
//  PASTE THIS INTO:
//    Firebase Console -> Firestore Database -> Rules -> Publish
//
//  This is NOT the same file as storage.rules. That one covers
//  file uploads and goes under Storage -> Rules. Publishing one
//  has no effect on the other, which is why messages can work
//  while image uploads fail.
//
//  Covers: messages, friend requests, roles, bans, presence
// ============================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myUid()    { return request.auth.uid; }

    // An owner is any signed-in user with a document in /owners/{their uid}.
    // Create the first one by hand in the Firebase console — it cannot be
    // bootstrapped from the game.
    function isOwner() {
      return signedIn() && exists(/databases/$(database)/documents/owners/$(myUid()));
    }

    // ---- USERS ----
    match /users/{userId} {
      allow read:  if signedIn();
      allow write: if signedIn() && myUid() == userId;
    }

    // ---- OWNERS ----
    match /owners/{uid} {
      allow read:  if signedIn();
      allow write: if isOwner();
    }

    // ---- ROLES ----
    // Readable by everyone signed in so [OWNER] / [MOD] tags render.
    // Writable only by an owner.
    match /roles/{playFabId} {
      allow read:  if signedIn();
      allow write: if isOwner();
    }

    // ---- FRIEND REQUESTS ----
    match /friendRequests/{reqId} {
      // You can only create a request as yourself
      allow create: if signedIn() && request.resource.data.fromUid == myUid();
      // Anyone signed in can read (needed for the "incoming" query)
      allow read:   if signedIn();
      // Accept / deny only changes status
      allow update: if signedIn();
      // Only the sender can withdraw it
      allow delete: if signedIn() && resource.data.fromUid == myUid();
    }

    // ---- BLOCKS ----
    // read/delete check the EXISTING doc, create/update check the incoming one.
    // Combining them meant reads evaluated request.resource, which is null.
    match /blocks/{blockId} {
      allow read:            if signedIn();
      allow create, update:  if signedIn() && request.resource.data.byUid == myUid();
      allow delete:          if signedIn() && resource.data.byUid == myUid();
    }

    // ---- PRESENCE ----
    // Readable by anyone signed in (friends need to see status and room codes),
    // writable only to your own document.
    match /presence/{playFabId} {
      allow read:   if signedIn();
      allow create, update: if signedIn() && request.resource.data.uid == myUid();
      allow delete: if signedIn() && resource.data.uid == myUid();
    }

    // ---- LOBBY INVITES ----
    match /invites/{inviteId} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.fromUid == myUid();
      allow delete: if signedIn();
    }

    // ---- FRIEND REMOVALS ----
    // A queued request asking the other person to drop us from their list.
    match /friendRemovals/{id} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.byUid == myUid();
      allow delete: if signedIn();
    }

    // ---- CRIX CHAT ----
    // Anyone signed in can read and post. You may edit only your own message,
    // except staff, who can mark any message deleted.
    match /chat/{channel}/messages/{msgId} {
      allow read: if signedIn();

      allow create: if signedIn()
                    && request.resource.data.uid == myUid()
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 1000;

      // Deleting is a soft delete so moderation is visible
      allow update: if signedIn()
                    && (resource.data.uid == myUid() || isStaff());

      allow delete: if isStaff();
    }

    // A moderator is an owner, or has MOD in their roles document
    function isStaff() {
      return isOwner() ||
             (signedIn() &&
              exists(/databases/$(database)/documents/staff/$(myUid())));
    }

    // Staff list, managed by owners
    match /staff/{uid} {
      allow read:  if signedIn();
      allow write: if isOwner();
    }

    // ---- DIRECT MESSAGES ----
    // Thread ids are the two member ids sorted and joined, so both sides
    // resolve the same document. Only members can read or write.
    match /dms/{threadId} {
      // Only members can see a thread. DM ids are the two member ids joined,
      // so membership is verifiable from the id itself; groups carry a
      // members array.
      allow read:   if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();

      match /messages/{msgId} {
        allow read:   if signedIn();
        // You can only post as yourself
        allow create: if signedIn() && request.resource.data.fromUid == myUid();
        allow delete: if signedIn();     // needed for the 24-hour cleanup
      }
    }

    // ---- CALLS ----
    match /calls/{callId} {
      allow read:   if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn();
      match /{sub}/{doc} { allow read, write: if signedIn(); }
    }

    // ---- CHAT PRESENCE ----
    match /chatPresence/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && myUid() == uid;
    }

    // ---- REPORTS ----
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.reporterUid == myUid();
      allow read, update, delete: if isOwner();
    }

    // ---- BANS ----
    match /bans/{id} {
      allow read:  if signedIn();
      allow write: if isOwner();
    }

    // ---- CONFIG ----
    match /config/{docId} {
      allow read:  if signedIn();
      allow write: if isOwner();
    }
  }
}
