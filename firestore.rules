rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()  { return request.auth != null; }
    function myUid()     { return request.auth.uid; }

    // An owner is anyone with OWNER in /roles/{their playfab id}.
    // Roles can only be written by an existing owner, so this can't be
    // bootstrapped by a player — grant the first owner from the console.
    function isOwner() {
      return signedIn() && exists(/databases/$(database)/documents/owners/$(myUid()));
    }

    // ---- USERS ----
    match /users/{userId} {
      allow read, write: if signedIn() && myUid() == userId;
    }

    // ---- OWNERS ----
    // Add your own uid here by hand once, from the Firebase console.
    // After that, owners manage each other.
    match /owners/{uid} {
      allow read:  if signedIn();
      allow write: if isOwner();
    }

    // ---- ROLES ----
    // Anyone signed in can READ roles (needed to show [OWNER] / [MOD] tags),
    // but only an owner can grant or remove them.
    match /roles/{playFabId} {
      allow read:  if signedIn();
      allow write: if isOwner();
    }

    // ---- FRIEND REQUESTS ----
    // You may create a request only as yourself, read ones you sent or
    // received, and update only the ones addressed to you (accept / deny).
    match /friendRequests/{reqId} {
      allow create: if signedIn()
                    && request.resource.data.fromUid == myUid();
      allow read:   if signedIn();
      allow update: if signedIn()
                    && resource.data.toPlayFabId != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if signedIn() && resource.data.fromUid == myUid();
    }

    // ---- BLOCKS ----
    match /blocks/{blockId} {
      allow read, write: if signedIn() && request.resource.data.byUid == myUid();
      allow delete: if signedIn() && resource.data.byUid == myUid();
    }

    // ---- REPORTS ----
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.reporterUid == myUid();
      allow read, update, delete: if isOwner();
    }

    // ---- BANS ----
    match /bans/{id} {
      allow read:  if signedIn();
      allow write: if isOwner();
    }

    // ---- CONFIG ----
    match /config/{docId} {
      allow read:  if signedIn();
      allow write: if isOwner();
    }
  }
}
